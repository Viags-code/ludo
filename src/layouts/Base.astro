---
import '../styles/global.css';
import site from '../data/site.json';

interface Props { titre?: string; description?: string; image?: string }
const { titre, description = site.presentation, image } = Astro.props;
const titreComplet = titre ? `${titre} | ${site.nom}` : `${site.nom}, ${site.metier.toLowerCase()}`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="theme-color" content="#F7F4EF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap" />
  </head>
  <body>
    <slot />
  </body>
</html>
