---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import Photo from '../../components/Photo.astro';
import site from '../../data/site.json';
import { formatPrix, numeroInternational } from '../../lib/format';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { titre, prix, vendu, bois, dimensions, photos } = article.data;
const { Content } = await render(article);
const description = (article.body ?? '').replace(/\s+/g, ' ').trim().slice(0, 160);
const lienContact = `/contact?article=${encodeURIComponent(titre)}`;
const lienAppel = site.telephone ? `tel:${numeroInternational(site.telephone)}` : lienContact;
---
<Base titre={titre} description={description} image={photos[0]}>
  <main class="page">
    <div class="conteneur">
      <article class="fiche">
        <div class="galerie">
          <div class="galerie-defile" tabindex="0" aria-label="Photos">
            {photos.length === 0
              ? <div><Photo alt={titre} graine={article.id} chargement="eager" /></div>
              : photos.map((src, i) => <div><Photo src={src} alt={`${titre}, photo ${i + 1}`} graine={article.id} chargement={i === 0 ? 'eager' : 'lazy'} /></div>)}
          </div>
          <a class="bouton-rond retour" href="/" aria-label="Retour aux réalisations"><Icone nom="retour" /></a>
          {photos.length > 1 && <span class="compteur" aria-live="polite"><span data-photo>1</span> / {photos.length}</span>}
        </div>

        <div class="infos">
          <div style="display:flex;flex-direction:column;gap:6px">
            <span class:list={['statut', { vendu }]}>{vendu ? 'Vendu' : 'Disponible'}</span>
            <h1>{titre}</h1>
            <span class="prix">{formatPrix(prix)}</span>
          </div>
          {(bois || dimensions) && (
            <dl class="caracteristiques">
              {bois && <div><dt>Bois</dt><dd>{bois}</dd></div>}
              {dimensions && <div><dt>Dimensions</dt><dd>{dimensions}</dd></div>}
            </dl>
          )}
          <div class="description">
            <h2>Description</h2>
            <Content />
          </div>
        </div>
      </article>
    </div>
  </main>

  <div class="barre-bas">
    <div class="conteneur">
      <a class="bouton contour" href={lienAppel}>Appeler</a>
      <a class="bouton plein large" href={lienContact}>{vendu ? 'Commander une pièce similaire' : 'Je suis intéressé'}</a>
    </div>
  </div>
</Base>

<script>
  const defile = document.querySelector<HTMLElement>('.galerie-defile');
  const compteur = document.querySelector('[data-photo]');
  if (defile && compteur) {
    defile.addEventListener('scroll', () => {
      compteur.textContent = String(Math.round(defile.scrollLeft / defile.clientWidth) + 1);
    }, { passive: true });
  }
</script>
