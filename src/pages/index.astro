---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Photo from '../components/Photo.astro';
import site from '../data/site.json';
import { formatPrix } from '../lib/format';

const articles = (await getCollection('articles')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const premiere = articles.find((a) => a.data.photos[0])?.data.photos[0];
---
<Base image={premiere}>
  <main class="page">
    <div class="conteneur">
      <header class="entete">
        <div>
          <a class="nom" href="/">{site.nom}</a>
          <span class="sous-titre">{site.metier}, {site.ville}</span>
        </div>
        <a class="bouton-rond plein" href="/contact" aria-label="Contacter Ludo"><Icone nom="tel" /></a>
      </header>

      <div class="filtres" role="group" aria-label="Filtrer les réalisations">
        <button class="filtre" type="button" data-filtre="tout" aria-pressed="true">Tout</button>
        <button class="filtre" type="button" data-filtre="dispo" aria-pressed="false">Disponibles</button>
        <button class="filtre" type="button" data-filtre="vendu" aria-pressed="false">Vendus</button>
      </div>

      {articles.length === 0 && <p class="vide">Les premières réalisations arrivent bientôt.</p>}
      <div class="grille">
        {articles.map((article, i) => (
          <a class="carte" href={`/articles/${article.id}`} data-vendu={article.data.vendu ? 'oui' : 'non'}>
            <div class="vignette">
              <Photo src={article.data.photos[0]} alt={article.data.titre} graine={article.id} chargement={i < 4 ? 'eager' : 'lazy'} />
              {article.data.vendu && <span class="etiquette">Vendu</span>}
            </div>
            <div>
              <div class="prix">{formatPrix(article.data.prix)}</div>
              <div class="titre">{article.data.titre}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <div class="barre-bas">
    <div class="conteneur">
      <a class="bouton plein" href="/contact">Une question ? Contacter Ludo</a>
    </div>
  </div>
</Base>

<script>
  const boutons = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
  const cartes = document.querySelectorAll<HTMLElement>('.carte');
  boutons.forEach((bouton) => {
    bouton.addEventListener('click', () => {
      const filtre = bouton.dataset.filtre;
      boutons.forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)));
      cartes.forEach((carte) => {
        const vendu = carte.dataset.vendu === 'oui';
        carte.hidden = (filtre === 'dispo' && vendu) || (filtre === 'vendu' && !vendu);
      });
    });
  });
</script>
